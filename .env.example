# Redoctor Web — environment variables
# Copy to .env.local for development. Preview and production values live in
# Vercel. Everything prefixed NEXT_PUBLIC_ reaches the browser: only values
# that are public by design belong there. Every variable is validated in
# app/lib/env.ts; a missing or malformed one fails the build by name.
# The unit tests read .env.test (same keys): keep both files in sync.

# development | preview | production
NEXT_PUBLIC_APP_ENV=development

# Canonical origin: links, OG tags and the deep-link scheme are built from it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The API. There is no production API yet: every environment points to dev.
NEXT_PUBLIC_API_URL=https://api-dev.redoctorapp.com/api/v1

# Firebase web app of project redoctor-3acf8 (shared with the mobile app).
# The API key is a public client key: restrict it by HTTP referrer in Google Cloud.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyCt6Rzgu06_atWspSTVq2jZxPWSk9shxqI
# redoctorapp.com once /__/auth/* is proxied to redoctor-3acf8.firebaseapp.com
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=redoctor-3acf8.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=redoctor-3acf8
NEXT_PUBLIC_FIREBASE_APP_ID=1:640755008477:web:3a195209f27154b9e56c34
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=640755008477
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=redoctor-3acf8.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-3ZB1NQ7NHG

# PostHog (funnel by origin, no personal data). Empty key = analytics off.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry. Empty DSN = Sentry off (development). The token is CI-only and
# never NEXT_PUBLIC_.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Store listings: EMPTY during the pilot (TestFlight / Play internal testing).
# With values, the app bridge shows store buttons and the iOS Smart App Banner.
NEXT_PUBLIC_APP_STORE_ID=
NEXT_PUBLIC_PLAY_STORE_ID=

# The mobile app, for the bridge (intent:// on Android) and the .well-known files.
NEXT_PUBLIC_IOS_BUNDLE_ID=com.redoctor.mobileapp
NEXT_PUBLIC_APPLE_TEAM_ID=SLAQ84BD94
NEXT_PUBLIC_ANDROID_PACKAGE=com.redoctor.mobileapp

# Support channels. Provisional: they will come from the API's configuration
# endpoint (REDOC-357). Format: Label|+58XXXXXXXXXX, comma-separated.
NEXT_PUBLIC_SUPPORT_WHATSAPP=Redoctor|+584227362867
NEXT_PUBLIC_SUPPORT_PHONES=Soporte 1|+584145598216,Soporte 2|+584245582129

# Google Places for the search's «¿Dónde?» (M16): the web's SERVER asks
# Google's Place Autocomplete and Place Details (the same web services the
# app calls, Venezuela only), so this key never reaches the browser. Never
# NEXT_PUBLIC_. The app's key works here for now (owner, 2026-10-13); restrict
# it by IP or make one of the web's own before launch (AGENTS.md §11).
# EMPTY = the box offers no places (only the device's position).
GOOGLE_PLACES_API_KEY=

# Google Maps for the search's map (M16): a BROWSER key of the web's own,
# restricted by HTTP referrer (redoctorapp.com and the Vercel preview domain)
# with the Maps JavaScript API enabled. The app's key does NOT serve here: it
# is restricted to the app's APIs and Google refuses it for this one. EMPTY =
# no map. The map id is optional (a Cloud map style); without one the map
# uses Google's demo style.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Development only: proxy for authenticated browser calls until the API opens
# CORS (REDOC-362). Must be absent in preview and production (the build fails).
API_PROXY_TARGET=https://api-dev.redoctorapp.com/api/v1

# ---------------------------------------------------------------------------
# Testing and CI only: never in Vercel, never NEXT_PUBLIC_.
# Run the e2e suite against a deployed URL instead of a local build.
# PLAYWRIGHT_BASE_URL=https://redoctor-web-app-git-branch.vercel.app
# The public profile the e2e and Lighthouse runs use (api-dev's test profile
# by default).
# E2E_SPECIALIST_ID=
# GitHub Actions secret, only when Vercel previews have Deployment Protection
# (Vercel → Deployment Protection → Protection Bypass for Automation).
# VERCEL_AUTOMATION_BYPASS_SECRET=
