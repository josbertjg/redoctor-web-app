    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "client-only": "^0.0.1",
    "clsx": "^2.1.1",
    "firebase": "^13.0.0",
    "framer-motion": "^14.0.0",
    "next": "16.4.0",
    "next-intl": "^4.14.9",
    "posthog-js": "^1.438.1",
    "radix-ui": "^1.6.7",
